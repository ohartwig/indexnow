{
    "name": "koh/indexnow",
    "description": "Framework-agnostic IndexNow client: key handling, a host policy that keeps non-production hosts out, spec-conform submissions and a PSR-18 transport.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "indexnow",
        "seo",
        "search-engine",
        "bing",
        "psr-18"
    ],
    "authors": [
        {
            "name": "Kai Ole Hartwig",
            "email": "mail@ole-hartwig.eu"
        }
    ],
    "homepage": "https://ole-hartwig.eu/open-source",
    "support": {
        "issues": "https://git.ole-hartwig.eu/ai-ready-platform/platform/indexnow/-/issues",
        "source": "https://github.com/ole-hartwig/indexnow"
    },
    "require": {
        "php": "^8.5.11",
        "psr/http-client": "^1.0.3",
        "psr/http-factory": "^1.1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "infection/infection": "^0.35.5",
        "nyholm/psr7": "^1.8.2",
        "phpstan/phpstan": "^2.2.16",
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0"
    },
    "suggest": {
        "ext-intl": "Converts internationalised host names to their ASCII form before they are checked and submitted."
    },
    "autoload": {
        "psr-4": {
            "Koh\\IndexNow\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Koh\\IndexNow\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    }
}
